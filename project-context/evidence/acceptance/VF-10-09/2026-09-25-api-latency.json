  "findings": [
    "Kie provider completion is followed by 11 to 94 seconds before application acceptance.",
    "The old mutable-list modulo cursor polls one submitted job per observation and can repeatedly skip jobs as submissions/completions change the list.",
    "Fal reported processing is 7 to 11 seconds; remaining submitted-to-accepted time combines provider queue, app observation and transfer. Cold start is not established."
  ],
  "new_generation_calls": 0,
  "limits": [
    "Historical provider data cannot establish future warm-start guarantees.",
    "No post-release hosted paid production timing is claimed."
  ],
  "changes": [
    "Visit every submitted result per pass without mutable-list modulo skipping.",
    "Serial media verification/storage retains original per-item memory bounds.",
    "Fal submissions start concurrently within existing four-avatar cap; Kie starts are paced within existing eight-image cap and published key rate limits.",
    "A known submission failure stops queued paid submissions; exact IDs and unknown no-replay states remain authoritative."
  ],
