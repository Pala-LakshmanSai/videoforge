{
  "schema_version": "videoforge.v2-07-staged-endpoint-definition/v6",
  "stage": "bounded_concurrent_reader_proof_only",
  "region": "EU-RO-1",
  "image": "ghcr.io/pala-lakshmansai/videoforge-mage-v2-07@sha256:bc662a182b2a874c6aeffb05f65cc3ffbdff6b5130c6a75c214618e86cf208b5",
  "image_source_commit": "79f123268b6ade640c02dd20616a89d16b43a5e6",
  "control_source_commit": "bb9abc03f286cae56bf874fe47dc1d7ebddb1fe9",
  "network_volume_id_sha256": "sha256:eae4e1ecee86be5d8bed2f6814e06332bc8a97e9f35767771d28c10cfdecd619",
  "network_volume_size_gb": 50,
  "network_volume_region": "EU-RO-1",
  "network_volume_mount": "/runpod-volume",
  "model_root": "/runpod-volume/mage-model",
  "volume_write_policy": "APPLICATION_READ_ONLY",
  "gpu_type_ids": [
    "NVIDIA GeForce RTX 4090"
  ],
  "gpu_count_per_worker": 1,
  "compute_type": "GPU",
  "flex_only": true,
  "workers_min": 0,
  "workers_max": 2,
  "scaler_type": "REQUEST_COUNT",
  "scaler_value": 1,
  "handler_concurrency": 1,
  "idle_timeout_seconds": 5,
  "init_timeout_seconds": 800,
  "execution_timeout_seconds": 2400,
  "request_authority_ttl_seconds": 7200,
  "container_disk_gb": 120,
  "flashboot": true,
  "flashboot_basis": "ATTEMPT_25_STARTUP_TERMINAL_INVENTORY_EXACTLY_PINNED",
  "cuda_minimum": "13.0",
  "cuda_allowed": [
    "13.0"
  ],
  "offline_environment": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "DIFFUSERS_OFFLINE": "1"
  },
  "endpoint_identity_binding": {
    "method": "POST_TEMPLATE_ENVIRONMENT_THEN_GET_TEMPLATE_EXACT_ID_AND_ENV_THEN_PATCH_DOCUMENTED_MUTABLE_FIELDS_ACCEPT_EXACT_ID_PARTIAL_ACK_THEN_GET_EFFECTIVE_ENDPOINT_READBACK_WITH_SAFE_MISMATCH_CATEGORY_BEFORE_DISPATCH",
    "environment_key": "VIDEOFORGE_MAGE_ENDPOINT_ID_HASH",
    "value": "sha256(raw allocated endpoint id)",
    "raw_endpoint_id_persisted": false,
    "template_update_response_must_match": true,
    "endpoint_patch_must_exclude_environment": true,
    "endpoint_patch_must_exclude_compute_type": true,
    "endpoint_patch_acknowledgement_requires_exact_endpoint_id": true,
    "endpoint_patch_acknowledgement_omitted_fields_are_unconfirmed": true,
    "endpoint_patch_acknowledgement_present_known_fields_must_match": true,
    "configuration_or_environment_drift_fails_closed": true,
    "endpoint_get_readback_compute_type_and_data_center_ids_optional_if_omitted_exact_if_present": true,
    "endpoint_get_readback_must_match_all_other_config_and_exact_environment": true,
    "get_mismatch_category_persisted_redaction_safe": true,
    "get_mismatch_category_stops_before_dispatch": true
  },
  "output_contract_diagnostic": {
    "first_completed_job_non_success": "persist_bounded_diagnostics_and_stop",
    "allowed_evidence_fields": [
      "error",
      "error_category",
      "output_failure_stage",
      "output_status",
      "output_failure_code",
      "output_shape_kind",
      "output_shape_keys"
    ],
    "output_status_rule": "safe_allowlisted_code_or_MISSING",
    "output_failure_code_rule": "safe_allowlisted_code_or_UNKNOWN",
    "output_shape_kind_allowlist": [
      "missing",
      "null",
      "array",
      "string",
      "number",
      "boolean",
      "object"
    ],
    "output_shape_keys_allowlist": [
      "status",
      "items",
      "failure_code",
      "error",
      "provenance_receipt"
    ],
    "provider_body_retained": false,
    "raw_output_retained": false,
    "retry_on_non_success": false,
    "duplicate_dispatch_on_non_success": false,
    "stop_before_next_batch_or_reader": true,
    "output_failure_stage_rule": "safe_allowlisted_code_or_unknown",
    "output_failure_stage_allowlist": [
      "top_level",
      "item_count",
      "authority_count",
      "receipt_presence",
      "receipt_hash",
      "receipt_signature",
      "receipt_identity",
      "output_lineage",
      "output_readback",
      "output_png_probe",
      "output_finalization",
      "output_finalization_replay",
      "unknown"
    ]
  },
  "cloudflare_route_restoration": {
    "hard_deadline_seconds": 120,
    "probe_interval_seconds": 2,
    "required_consecutive_exact_fingerprints": 16,
    "minimum_stability_window_seconds": 30,
    "mismatch_or_probe_error_after_first_match_fails_closed": true
  },
  "scope": "two simultaneous read-only workers only; restore max one immediately after proof",
  "ephemeral_secret_values": "injected_at_execution_and_excluded_from_this_public_definition",
  "runtime_config_hash": "computed_separately_after_exact_endpoint_template_id_endpoint_hash_and_ephemeral_values_persisted_before_reader_dispatch",
  "startup_terminal_inventory_fallback": {
    "allowed_before_dispatch_only": true,
    "allowed_before_any_owned_job": true,
    "allowed_before_initial_qualification": true,
    "trigger": "fresh_endpoint_health_counters_incomplete_or_stale_after_warm_idle_failure",
    "exact_inventory_required": [
      "fresh_endpoint_scoped_worker_inventory",
      "fresh_endpoint_scoped_pod_inventory",
      "all_observed_worker_and_pod_records_terminal_EXITED_or_TERMINATED",
      "no_owned_jobs",
      "no_in_progress_or_queued_jobs",
      "exactly_two_stable_inventory_snapshots",
      "matching_inventory_signatures",
      "zero_nonterminal_records"
    ],
    "worker_health_counters_required_for_startup_fallback": false,
    "health_jobs_required_for_startup_fallback": {
      "object_present": true,
      "in_queue_present": true,
      "in_queue_exact": 0,
      "in_progress_present": true,
      "in_progress_exact": 0
    },
    "health_jobs_reads_bracketing_inventory": {
      "before_first_inventory_snapshot": "required_object_present_and_exact_zero",
      "after_first_inventory_snapshot": "required_object_present_and_exact_zero",
      "before_second_inventory_snapshot": "required_object_present_and_exact_zero",
      "after_second_inventory_snapshot": "required_object_present_and_exact_zero",
      "job_read_signatures_match": true,
      "all_reads_required": true
    },
    "dispatch_allowed_after_pass": true,
    "dispatch_forbidden_after_fail": true,
    "post_dispatch_or_drain_fallback_forbidden": true,
    "post_drain_policy": "health_first_confirm_quiescent",
    "cancellation_policy": "health_first_confirm_quiescent",
    "concurrent_reader_policy": "health_first_confirm_quiescent",
    "cleanup_policy": "health_first_confirm_quiescent",
    "no_retry_or_duplicate_compute": true
  }
}
