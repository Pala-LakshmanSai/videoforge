    "seed_units": ["scene-01"],
    "replacement_units": 31,
    "replacement_requires_seed_terminal_and_scale_zero": true,
    "replacement_process_identity_must_differ": true,
    "replacement_executes_only_unresolved_units": true,
    "accepted_units_never_regenerated": true,
    "merge_requires_exact_plan_order_and_unique_ids": true
