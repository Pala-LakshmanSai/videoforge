  "negative_contracts": [
    "wrong image bytes or digest",
    "wrong path, volume, GPU, or region",
    "model-volume write or cache escape",
    "malformed authority or duplicate delivery",
    "cancel and timeout without terminal reconciliation",
    "two-reader configuration drift",
    "uncertain cleanup, rollback, or cap risk"
