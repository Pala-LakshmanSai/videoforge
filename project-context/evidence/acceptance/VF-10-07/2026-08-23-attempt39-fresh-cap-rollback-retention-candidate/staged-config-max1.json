    "versions_list_limit": 10,
    "required_anchor_retention": "NEWEST_SEVEN",
    "reject_absent_or_older_anchor_before_any_worker_or_secret_mutation": true,
    "restore_exact_version_and_record_hash": true,
    "latest_observed_route_status": 404,
    "latest_observed_route_code": "V207_ROUTE_DISABLED",
    "capture_exact_route_fingerprint_again_before_mutation": true,
    "require_exact_route_fingerprint_after_rollback": true
  }
