{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoforge.local/schemas/admitted-identity-v2.json",
  "title": "VideoForge Admitted Identity v2",
  "description": "Provider-free global admission identity used by vNext generation-session mutations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "admission_id",
    "user_id",
    "normalized_email",
    "email_verified_at",
    "invite_redemption_id",
    "auth_methods",
    "status",
    "version"
  ],
  "properties": {
    "schema_version": {"const": "admitted-identity/v2"},
    "admission_id": {"$ref": "#/$defs/id"},
    "user_id": {"$ref": "#/$defs/id"},
    "normalized_email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 320,
      "pattern": "^[^@\\s]+@[^@\\s]+$"
    },
    "email_verified_at": {"$ref": "#/$defs/timestamp"},
    "invite_redemption_id": {"$ref": "#/$defs/id"},
    "auth_methods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["EMAIL_PASSWORD", "GOOGLE"]}
    },
    "status": {"const": "ADMITTED"},
    "version": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
