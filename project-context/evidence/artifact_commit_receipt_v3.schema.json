{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoforge.local/schemas/artifact-commit-receipt-v3.json",
  "title": "VideoForge durable artifact commit receipt v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "reservation_id", "account_id", "workspace_id", "object_key", "callback_id", "content_type", "content_length", "checksum_sha256", "probe", "retention_class", "committed_at", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "artifact-commit-receipt/v3"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "reservation_id": {"$ref": "#/$defs/id"},
    "account_id": {"$ref": "#/$defs/id"},
    "workspace_id": {"$ref": "#/$defs/id"},
    "object_key": {"type": "string", "minLength": 1, "maxLength": 1400},
    "callback_id": {"$ref": "#/$defs/id"},
    "content_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$"},
    "content_length": {"type": "integer", "minimum": 0, "maximum": 10737418240},
    "checksum_sha256": {"$ref": "#/$defs/sha256"},
    "probe": {"type": "object", "maxProperties": 64, "additionalProperties": {"oneOf": [{"type": "boolean"}, {"type": "number"}, {"type": "string"}, {"type": "null"}]}},
    "retention_class": {"enum": ["EPHEMERAL", "PROJECT", "FINAL", "LEGAL_HOLD"]},
    "retain_until": {"oneOf": [{"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}, {"type": "null"}]},
    "committed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
