{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoforge.local/schemas/resolved-render-manifest-v1.json",
  "title": "VideoForge Resolved Render Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_revision_id",
    "revision_config_hash",
    "timeline_plan_hash",
    "render_profile_version",
    "voiceover",
    "output",
    "total_frames",
    "segments"
  ],
  "properties": {
    "schema_version": {"const": "resolved-render-manifest/v1"},
    "project_revision_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "revision_config_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timeline_plan_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "render_profile_version": {
      "enum": ["ffmpeg-render-v1", "ffmpeg-render-v2", "ffmpeg-render-v3"]
    },
    "voiceover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "sha256"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width", "height", "fps_num", "fps_den", "video_codec",
        "pixel_format", "audio_codec", "audio_sample_rate_hz", "loudness_profile"
      ],
      "properties": {
        "width": {"const": 1920},
        "height": {"const": 1080},
        "fps_num": {"const": 30},
        "fps_den": {"const": 1},
        "video_codec": {"const": "h264"},
        "pixel_format": {"const": "yuv420p"},
        "audio_codec": {"const": "aac"},
        "audio_sample_rate_hz": {"const": 48000},
        "loudness_profile": {"const": "voiceover-minus16lufs-v1"}
      }
    },
    "total_frames": {"type": "integer", "minimum": 1},
    "soulx_crop_profile_approval": {"$ref": "#/$defs/soulxCropProfileApproval"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/avatarFull"},
          {"$ref": "#/$defs/imageFull"},
          {"$ref": "#/$defs/avatarSplitImage"}
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "segments": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "render": {
                  "type": "object",
                  "properties": {
                    "avatar_source_profile": {"const": "soulx-pro-vf924u-approved-v1"}
                  },
                  "required": ["avatar_source_profile"]
                }
              },
              "required": ["render"]
            }
          }
        }
      },
      "then": {
        "required": ["soulx_crop_profile_approval"],
        "properties": {
          "soulx_crop_profile_approval": {"$ref": "#/$defs/soulxCropProfileApproval"}
        }
      }
    }
  ],
  "$defs": {
    "soulxCropProfileApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_group_id", "candidate_sha256", "approval_sha256", "avatar_source_sha256",
        "native_sample_sha256", "full_sample_sha256", "split_sample_sha256"
      ],
      "properties": {
        "profile_group_id": {"const": "soulx-pro-vf924u-full-split-v1"},
        "candidate_sha256": {"const": "sha256:f6c8dd219c07a26ab67fb13d8dbc103e110b4c045307f8c3e0c70aa3d805d442"},
        "approval_sha256": {"const": "sha256:c3aae03da3f0134e12c2f432951189bd205dcbb7ab26a65d44061cec82984c45"},
        "avatar_source_sha256": {"const": "sha256:37f07580badf2c459db496e0a74a15e524534b91432478d5e84e8f084e6b1e83"},
        "native_sample_sha256": {"const": "sha256:db70cd410062572052313278f12d67393aba213ca607fa3a3b9e3f6aad948bf1"},
        "full_sample_sha256": {"const": "sha256:da31d87c2389769272733ff50a9114d4507a36aced1ebe48480c9ccf486de241"},
        "split_sample_sha256": {"const": "sha256:f0b02351e38e2e8570e4e586b314da30813bb0a0eb09a567912bba9725b74993"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "sha256"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "avatarFull": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "start_frame", "end_frame_exclusive", "timeline_composition", "accepted_assets", "render"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame_exclusive": {"type": "integer", "minimum": 1},
        "timeline_composition": {"const": "AVATAR_FULL"},
        "accepted_assets": {
          "type": "object", "additionalProperties": false, "required": ["avatar"],
          "properties": {
            "avatar": {"$ref": "#/$defs/asset"},
            "source_background": {"$ref": "#/$defs/asset"}
          }
        },
        "render": {
          "type": "object", "additionalProperties": false,
          "required": ["avatar_source_profile", "avatar_scale", "avatar_fps"],
          "properties": {
            "avatar_source_profile": {
              "enum": [
                "local-fixture-centered-832x480p25-v1",
                "avatarforcing-centered-832x480p25-v1",
                "skyreels-centered-960x960p25-v2",
                "echomimic-v3-flash-turbo-fp8-centered-1024x560p25-v1",
                "soulx-pro-vf924u-approved-v1"
              ]
            },
            "avatar_crop": {"enum": ["832:468:0:6", "960:540:0:210", "992:558:16:0"]},
            "crop_profile_id": {"const": "soulx-pro-ranga-full-source-composite-v1"},
            "crop_profile_evidence_sha256": {"const": "sha256:f6c8dd219c07a26ab67fb13d8dbc103e110b4c045307f8c3e0c70aa3d805d442"},
            "crop_profile_acceptance_sha256": {"const": "sha256:c3aae03da3f0134e12c2f432951189bd205dcbb7ab26a65d44061cec82984c45"},
            "source_background_transform": {"const": "scale=1920:1080:flags=lanczos,fps=30"},
            "native_foreground_transform": {"const": "scale=1080:1080:flags=lanczos,fps=30,format=rgba"},
            "native_foreground_overlay": {
              "type": "object", "additionalProperties": false, "required": ["x", "y"],
              "properties": {"x": {"const": 420}, "y": {"const": 0}}
            },
            "horizontal_alpha_feather_pixels_each_edge": {"const": 32},
            "avatar_scale": {"const": "1920:1080"},
            "avatar_fps": {"const": "30:round=near"}
          },
          "allOf": [
            {
              "if": {"properties": {"avatar_source_profile": {"const": "local-fixture-centered-832x480p25-v1"}}},
              "then": {"required": ["avatar_crop"], "properties": {"avatar_crop": {"const": "832:468:0:6"}}}
            },
            {
              "if": {"properties": {"avatar_source_profile": {"const": "avatarforcing-centered-832x480p25-v1"}}},
              "then": {"required": ["avatar_crop"], "properties": {"avatar_crop": {"const": "832:468:0:6"}}}
            },
            {
              "if": {"properties": {"avatar_source_profile": {"const": "skyreels-centered-960x960p25-v2"}}},
              "then": {"required": ["avatar_crop"], "properties": {"avatar_crop": {"const": "960:540:0:210"}}}
            },
            {
              "if": {"properties": {"avatar_source_profile": {"const": "echomimic-v3-flash-turbo-fp8-centered-1024x560p25-v1"}}},
              "then": {"required": ["avatar_crop"], "properties": {"avatar_crop": {"const": "992:558:16:0"}}}
            },
            {
              "if": {"properties": {"avatar_source_profile": {"const": "soulx-pro-vf924u-approved-v1"}}},
              "then": {
                "required": [
                  "crop_profile_id", "crop_profile_evidence_sha256", "crop_profile_acceptance_sha256",
                  "source_background_transform", "native_foreground_transform",
                  "native_foreground_overlay", "horizontal_alpha_feather_pixels_each_edge"
                ],
                "properties": {
                  "crop_profile_id": {"const": "soulx-pro-ranga-full-source-composite-v1"},
                  "crop_profile_evidence_sha256": {"const": "sha256:f6c8dd219c07a26ab67fb13d8dbc103e110b4c045307f8c3e0c70aa3d805d442"},
                  "crop_profile_acceptance_sha256": {"const": "sha256:c3aae03da3f0134e12c2f432951189bd205dcbb7ab26a65d44061cec82984c45"},
                  "source_background_transform": {"const": "scale=1920:1080:flags=lanczos,fps=30"},
                  "native_foreground_transform": {"const": "scale=1080:1080:flags=lanczos,fps=30,format=rgba"},
                  "native_foreground_overlay": {
                    "type": "object", "additionalProperties": false, "required": ["x", "y"],
                    "properties": {"x": {"const": 420}, "y": {"const": 0}}
                  },
                  "horizontal_alpha_feather_pixels_each_edge": {"const": 32}
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "render": {
                "type": "object",
                "properties": {"avatar_source_profile": {"const": "soulx-pro-vf924u-approved-v1"}},
                "required": ["avatar_source_profile"]
              }
            }
          },
          "then": {
            "properties": {
              "accepted_assets": {
                "type": "object",
                "required": ["source_background"],
                "properties": {
                  "source_background": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["asset_id", "sha256"],
                    "properties": {
                      "asset_id": {"type": "string", "minLength": 1, "maxLength": 160},
                      "sha256": {"const": "sha256:37f07580badf2c459db496e0a74a15e524534b91432478d5e84e8f084e6b1e83"}
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "imageFull": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "start_frame", "end_frame_exclusive", "timeline_composition", "accepted_assets", "render"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame_exclusive": {"type": "integer", "minimum": 1},
        "timeline_composition": {"const": "IMAGE_FULL"},
        "accepted_assets": {
          "type": "object", "additionalProperties": false, "required": ["image"],
          "properties": {"image": {"$ref": "#/$defs/asset"}}
        },
        "render": {
          "type": "object", "additionalProperties": false,
          "required": ["image_scale", "zoom_profile"],
          "properties": {
            "image_scale": {"const": "1920:1080"},
            "zoom_profile": {
              "enum": ["image-full-zoom-v1", "image-full-zoom-v2", "image-full-zoom-v3"]
            }
          }
        }
      }
    },
    "avatarSplitImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "start_frame", "end_frame_exclusive", "timeline_composition", "accepted_assets", "render"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame_exclusive": {"type": "integer", "minimum": 1},
        "timeline_composition": {"const": "AVATAR_SPLIT_IMAGE"},
        "accepted_assets": {
          "type": "object", "additionalProperties": false, "required": ["avatar", "right_image"],
          "properties": {
            "avatar": {"$ref": "#/$defs/asset"},
            "right_image": {"$ref": "#/$defs/asset"}
          }
        },
        "render": {
          "type": "object", "additionalProperties": false,
          "required": ["avatar_source_profile", "avatar_crop", "avatar_scale", "avatar_fps", "right_image_scale", "right_image_zoom_profile"],
          "properties": {
            "avatar_source_profile": {
              "enum": [
                "local-fixture-centered-832x480p25-v1",
                "avatarforcing-centered-832x480p25-v1",
                "skyreels-centered-960x960p25-v2",
                "echomimic-v3-flash-turbo-fp8-centered-1024x560p25-v1",
                "soulx-pro-vf924u-approved-v1"
              ]
            },
            "avatar_crop": {"enum": ["416:468:208:6", "480:540:240:210", "496:558:280:0", "448:504:32:4"]},
            "crop_profile_id": {"const": "soulx-pro-ranga-split-composite-v1"},
            "crop_profile_evidence_sha256": {"const": "sha256:f6c8dd219c07a26ab67fb13d8dbc103e110b4c045307f8c3e0c70aa3d805d442"},
            "crop_profile_acceptance_sha256": {"const": "sha256:c3aae03da3f0134e12c2f432951189bd205dcbb7ab26a65d44061cec82984c45"},
            "context_transform": {"const": "scale=1920:1080:force_original_aspect_ratio=increase:flags=lanczos,crop=960:1080,zoompan=z=min(zoom+0.000133333,1.04):d=300:s=960x1080:fps=30"},
            "avatar_scale": {"const": "960:1080"},
            "avatar_fps": {"const": "30:round=near"},
            "right_image_scale": {"const": "960:1080"},
            "right_image_zoom_profile": {
              "enum": ["split-right-zoom-v1", "split-right-zoom-v2", "split-right-zoom-v3"]
            }
          },
          "allOf": [
            {
              "if": {"properties": {"avatar_source_profile": {"const": "local-fixture-centered-832x480p25-v1"}}},
              "then": {"properties": {"avatar_crop": {"const": "416:468:208:6"}}}
            },
            {
              "if": {"properties": {"avatar_source_profile": {"const": "avatarforcing-centered-832x480p25-v1"}}},
              "then": {"properties": {"avatar_crop": {"const": "416:468:208:6"}}}
            },
            {
              "if": {"properties": {"avatar_source_profile": {"const": "skyreels-centered-960x960p25-v2"}}},
              "then": {"properties": {"avatar_crop": {"const": "480:540:240:210"}}}
            },
            {
              "if": {"properties": {"avatar_source_profile": {"const": "echomimic-v3-flash-turbo-fp8-centered-1024x560p25-v1"}}},
              "then": {"properties": {"avatar_crop": {"const": "496:558:280:0"}}}
            },
            {
              "if": {"properties": {"avatar_source_profile": {"const": "soulx-pro-vf924u-approved-v1"}}},
              "then": {
                "required": ["crop_profile_id", "crop_profile_evidence_sha256", "crop_profile_acceptance_sha256", "context_transform"],
                "properties": {
                  "avatar_crop": {"const": "448:504:32:4"},
                  "crop_profile_id": {"const": "soulx-pro-ranga-split-composite-v1"},
                  "crop_profile_evidence_sha256": {"const": "sha256:f6c8dd219c07a26ab67fb13d8dbc103e110b4c045307f8c3e0c70aa3d805d442"},
                  "crop_profile_acceptance_sha256": {"const": "sha256:c3aae03da3f0134e12c2f432951189bd205dcbb7ab26a65d44061cec82984c45"},
                  "context_transform": {"const": "scale=1920:1080:force_original_aspect_ratio=increase:flags=lanczos,crop=960:1080,zoompan=z=min(zoom+0.000133333,1.04):d=300:s=960x1080:fps=30"}
                }
              }
            }
          ]
        }
      }
    }
  }
}
