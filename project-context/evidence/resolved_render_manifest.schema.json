{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoforge.local/schemas/resolved-render-manifest-v1.json",
  "title": "VideoForge Resolved Render Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_revision_id",
    "revision_config_hash",
    "timeline_plan_hash",
    "render_profile_version",
    "voiceover",
    "output",
    "total_frames",
    "segments"
  ],
  "properties": {
    "schema_version": {"const": "resolved-render-manifest/v1"},
    "project_revision_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "revision_config_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timeline_plan_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "render_profile_version": {"enum": ["ffmpeg-render-v1", "ffmpeg-render-v2"]},
    "voiceover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "sha256"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width", "height", "fps_num", "fps_den", "video_codec",
        "pixel_format", "audio_codec", "audio_sample_rate_hz", "loudness_profile"
      ],
      "properties": {
        "width": {"const": 1920},
        "height": {"const": 1080},
        "fps_num": {"const": 30},
        "fps_den": {"const": 1},
        "video_codec": {"const": "h264"},
        "pixel_format": {"const": "yuv420p"},
        "audio_codec": {"const": "aac"},
        "audio_sample_rate_hz": {"const": 48000},
        "loudness_profile": {"const": "voiceover-minus16lufs-v1"}
      }
    },
    "total_frames": {"type": "integer", "minimum": 1},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/avatarFull"},
          {"$ref": "#/$defs/imageFull"},
          {"$ref": "#/$defs/avatarSplitImage"}
        ]
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "sha256"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "avatarFull": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "start_frame", "end_frame_exclusive", "timeline_composition", "accepted_assets", "render"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame_exclusive": {"type": "integer", "minimum": 1},
        "timeline_composition": {"const": "AVATAR_FULL"},
        "accepted_assets": {
          "type": "object", "additionalProperties": false, "required": ["avatar"],
          "properties": {"avatar": {"$ref": "#/$defs/asset"}}
        },
        "render": {
          "type": "object", "additionalProperties": false,
          "required": ["avatar_source_profile", "avatar_crop", "avatar_scale", "avatar_fps"],
          "properties": {
            "avatar_source_profile": {
              "enum": [
                "avatarforcing-centered-832x480p25-v1",
                "skyreels-centered-1280x720p24-v1"
              ]
            },
            "avatar_crop": {"enum": ["832:468:0:6", "1280:720:0:0"]},
            "avatar_scale": {"const": "1920:1080"},
            "avatar_fps": {"const": "30:round=near"}
          },
          "allOf": [
            {
              "if": {"properties": {"avatar_source_profile": {"const": "avatarforcing-centered-832x480p25-v1"}}},
              "then": {"properties": {"avatar_crop": {"const": "832:468:0:6"}}}
            },
            {
              "if": {"properties": {"avatar_source_profile": {"const": "skyreels-centered-1280x720p24-v1"}}},
              "then": {"properties": {"avatar_crop": {"const": "1280:720:0:0"}}}
            }
          ]
        }
      }
    },
    "imageFull": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "start_frame", "end_frame_exclusive", "timeline_composition", "accepted_assets", "render"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame_exclusive": {"type": "integer", "minimum": 1},
        "timeline_composition": {"const": "IMAGE_FULL"},
        "accepted_assets": {
          "type": "object", "additionalProperties": false, "required": ["image"],
          "properties": {"image": {"$ref": "#/$defs/asset"}}
        },
        "render": {
          "type": "object", "additionalProperties": false,
          "required": ["image_scale", "zoom_profile"],
          "properties": {
            "image_scale": {"const": "1920:1080"},
            "zoom_profile": {"enum": ["image-full-zoom-v1", "image-full-zoom-v2"]}
          }
        }
      }
    },
    "avatarSplitImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "start_frame", "end_frame_exclusive", "timeline_composition", "accepted_assets", "render"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame_exclusive": {"type": "integer", "minimum": 1},
        "timeline_composition": {"const": "AVATAR_SPLIT_IMAGE"},
        "accepted_assets": {
          "type": "object", "additionalProperties": false, "required": ["avatar", "right_image"],
          "properties": {
            "avatar": {"$ref": "#/$defs/asset"},
            "right_image": {"$ref": "#/$defs/asset"}
          }
        },
        "render": {
          "type": "object", "additionalProperties": false,
          "required": ["avatar_source_profile", "avatar_crop", "avatar_scale", "avatar_fps", "right_image_scale", "right_image_zoom_profile"],
          "properties": {
            "avatar_source_profile": {
              "enum": [
                "avatarforcing-centered-832x480p25-v1",
                "skyreels-centered-1280x720p24-v1"
              ]
            },
            "avatar_crop": {"enum": ["416:468:208:6", "640:720:320:0"]},
            "avatar_scale": {"const": "960:1080"},
            "avatar_fps": {"const": "30:round=near"},
            "right_image_scale": {"const": "960:1080"},
            "right_image_zoom_profile": {
              "enum": ["split-right-zoom-v1", "split-right-zoom-v2"]
            }
          },
          "allOf": [
            {
              "if": {"properties": {"avatar_source_profile": {"const": "avatarforcing-centered-832x480p25-v1"}}},
              "then": {"properties": {"avatar_crop": {"const": "416:468:208:6"}}}
            },
            {
              "if": {"properties": {"avatar_source_profile": {"const": "skyreels-centered-1280x720p24-v1"}}},
              "then": {"properties": {"avatar_crop": {"const": "640:720:320:0"}}}
            }
          ]
        }
      }
    }
  }
}
