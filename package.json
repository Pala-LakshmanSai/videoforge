{
  "name": "videoforge",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "22.23.2",
    "pnpm": "11.5.2"
  },
  "scripts": {
    "build": "turbo run build",
    "build:check-generated": "node scripts/build-check-generated.mjs",
    "context:validate": "node scripts/context-validate.mjs",
    "contracts:sync": "pnpm --filter @videoforge/contracts sync",
    "contracts:check": "pnpm --filter @videoforge/contracts sync:check",
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:local": "node scripts/dev.mjs --mode=local",
    "dev:open": "node scripts/dev-open.mjs",
    "dev:status": "node scripts/dev-status.mjs",
    "db:check": "pnpm --filter @videoforge/control-plane test",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm lint:root && turbo run lint",
    "lint:root": "eslint scripts eslint.config.mjs prettier.config.mjs",
    "local:doctor": "node scripts/local-doctor.mjs",
    "local:model:fetch": "node scripts/fetch-whisper-model.mjs",
    "python:lint": "node scripts/python-lint.mjs",
    "python:sync": "node scripts/python-sync.mjs",
    "test": "pnpm test:scripts && turbo run test && pnpm test:workers",
    "test:chrome": "pnpm --filter @videoforge/web test:chrome",
    "test:local-slice": "node scripts/test-local-slice.mjs",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "test:workers": "node scripts/test-workers.mjs",
    "typecheck": "turbo run typecheck",
    "audit:dependencies": "pnpm audit --audit-level high",
    "secret:scan": "node scripts/secret-scan.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm python:lint && pnpm typecheck && pnpm db:check && pnpm test && pnpm contracts:check && pnpm context:validate && pnpm secret:scan && pnpm build:check-generated && pnpm test:chrome"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "eslint": "9.35.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "turbo": "2.10.9",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0"
  }
}
