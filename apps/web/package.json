{
  "name": "@videoforge/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:web && pnpm build:cloudflare",
    "build:cloudflare": "vite build --config vite.cloudflare.config.ts --outDir dist-cloudflare",
    "build:web": "vite build",
    "dev:cloudflare:raw": "vite --config vite.cloudflare.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "dev:raw": "concurrently -k -s first -n web,api -c magenta,cyan \"vite --host 127.0.0.1 --port 4173 --strictPort\" \"tsx watch src/server.ts\"",
    "dev:raw:lan": "concurrently -k -s first -n web,api -c magenta,cyan \"vite --host 0.0.0.0 --port 4173 --strictPort\" \"tsx watch src/server.ts\"",
    "lint": "eslint src worker tests vite.config.ts vite.cloudflare.config.ts vitest.config.ts playwright.config.ts playwright.cloudflare.config.ts playwright.local.config.ts tailwind.config.ts postcss.config.cjs",
    "test": "vitest run",
    "test:cloudflare": "playwright test --config playwright.cloudflare.config.ts",
    "test:chrome": "playwright test",
    "test:local-chrome": "playwright test --config playwright.local.config.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "5.85.5",
    "@tanstack/react-router": "1.131.35",
    "@videoforge/config": "workspace:*",
    "@videoforge/control-plane": "workspace:*",
    "@videoforge/contracts": "workspace:*",
    "@videoforge/pipeline": "workspace:*",
    "@videoforge/test-fixtures": "workspace:*",
    "hono": "4.13.1",
    "lucide-react": "0.542.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@cloudflare/workers-types": "5.20260804.1",
    "@playwright/test": "1.55.1",
    "@tailwindcss/forms": "0.5.10",
    "@tanstack/router-plugin": "1.131.35",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "autoprefixer": "10.4.21",
    "concurrently": "10.0.4",
    "jsdom": "26.1.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "wrangler": "4.120.0"
  }
}
