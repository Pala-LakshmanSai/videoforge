{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "videoforge-production-runtime",
  "account_id": "00000000000000000000000000000000",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "main": "./worker/production-index.ts",
  "assets": {
    "directory": "./dist-cloudflare/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "placement": { "mode": "smart" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "triggers": { "crons": ["17 2 * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true },
  },
  "r2_buckets": [
    {
      "binding": "PRIVATE_ARTIFACTS",
      "bucket_name": "videoforge-v2-13-r2-unresolved",
    },
  ],
  "workflows": [
    {
      "binding": "VIDEO_WORKFLOW",
      "name": "videoforge-v2-13-workflow-unresolved",
      "class_name": "HostedVideoWorkflow",
    },
    {
      "binding": "HOSTED_PAIR_WORKFLOW",
      "name": "videoforge-v2-13-pair-workflow-unresolved",
      "class_name": "HostedPairWorkflow",
    },
  ],
  "vars": {
    "VIDEOFORGE_COMMIT": "0000000000000000000000000000000000000000",
    "VIDEOFORGE_ENVIRONMENT": "production",
    "VIDEOFORGE_PROVIDER_MODE": "production",
    "VIDEOFORGE_PUBLIC_ORIGIN": "https://v2-13-public-origin-unresolved.invalid",
    "R2_ACCOUNT_ID": "00000000000000000000000000000000",
    "VIDEOFORGE_R2_BUCKET_NAME": "videoforge-v2-13-r2-unresolved",
    "VIDEOFORGE_R2_REGION": "auto",
    "MEDIA_WORKER_RELEASE_MANIFEST_JSON": "__V2_13_MEDIA_WORKER_RELEASE_MANIFEST_JSON__",
    "VIDEOFORGE_GPU_TRANSPORT": "DISABLED_UNQUALIFIED",
  },
}
