# VideoForge defaults to fixture mode. Values belong only in an untracked .env file.
VIDEOFORGE_PROVIDER_MODE=fixture
VIDEOFORGE_FIXTURE_SCENARIO=happy_generating
VIDEOFORGE_WEB_URL=http://localhost:4173

# Future server-only integration names; leave blank until an explicitly capped provider task.
RUNPOD_API_KEY=
RUNWARE_API_KEY=
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
