{
  "name": "@videoforge/provider-sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests --max-warnings 0",
    "qualify:deepseek": "node scripts/qualify-deepseek.mjs",
    "qualify:gemini-style": "pnpm --filter @videoforge/pipeline build && node scripts/qualify-gemini-style.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:typescript": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@videoforge/pipeline": "workspace:*",
    "eslint": "9.35.0",
    "typescript": "5.9.2"
  }
}
