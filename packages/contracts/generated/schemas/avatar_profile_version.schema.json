{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoforge.local/schemas/avatar-profile-version-v1.json",
  "title": "VideoForge Immutable Avatar Profile Version v1",
  "description": "Trusted immutable source payload for one READY reusable Avatar Profile version. Lifecycle, parent name/archive state, compatibility assessments, and timestamps live outside this payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_asset_id",
    "source_sha256",
    "source_media",
    "runtime_source_asset_id",
    "runtime_source_sha256",
    "thumbnail_asset_id",
    "thumbnail_sha256",
    "source_preparation_version",
    "source_validation_profile_version",
    "framing_confirmation",
    "rights_basis",
    "rights_attested_by_user_id",
    "rights_attested_at",
    "avatar_generation_consent",
    "likeness_animation_rights_attested",
    "likeness_attested_by_user_id",
    "likeness_attested_at"
  ],
  "properties": {
    "schema_version": {"const": "avatar-profile-version/v1"},
    "source_asset_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mime_type", "width", "height", "bytes"],
      "properties": {
        "mime_type": {"type": "string", "enum": ["image/jpeg", "image/png", "image/webp"]},
        "width": {"type": "integer", "minimum": 512, "maximum": 16384},
        "height": {"type": "integer", "minimum": 512, "maximum": 16384},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 20971520}
      }
    },
    "runtime_source_asset_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "runtime_source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "thumbnail_asset_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "thumbnail_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_preparation_version": {"type": "string", "minLength": 1, "maxLength": 160},
    "source_validation_profile_version": {"type": "string", "minLength": 1, "maxLength": 160},
    "framing_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_primary_presenter", "horizontally_centered", "direct_to_camera_suitable", "confirmed_by_user_id", "confirmed_at"],
      "properties": {
        "one_primary_presenter": {"const": true},
        "horizontally_centered": {"const": true},
        "direct_to_camera_suitable": {"const": true},
        "confirmed_by_user_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "confirmed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        }
      }
    },
    "rights_basis": {
      "type": "string",
      "enum": ["OWNED", "LICENSED", "PUBLIC_DOMAIN", "OTHER_DOCUMENTED_BASIS"]
    },
    "rights_attested_by_user_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "rights_attested_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "avatar_generation_consent": {"const": true},
    "likeness_animation_rights_attested": {"const": true},
    "likeness_attested_by_user_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "likeness_attested_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
