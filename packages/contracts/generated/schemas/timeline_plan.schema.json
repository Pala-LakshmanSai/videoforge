{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoforge.local/schemas/timeline-plan-v1.json",
  "title": "VideoForge Timeline Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_revision_id",
    "revision_config_hash",
    "scheduler_version",
    "seed",
    "output_fps_num",
    "output_fps_den",
    "total_frames",
    "segments"
  ],
  "properties": {
    "schema_version": {"const": "timeline-plan/v1"},
    "project_revision_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "revision_config_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scheduler_version": {"type": "string", "minLength": 1, "maxLength": 160},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "output_fps_num": {"const": 30},
    "output_fps_den": {"const": 1},
    "total_frames": {"type": "integer", "minimum": 1},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/avatarFull"},
          {"$ref": "#/$defs/imageFull"},
          {"$ref": "#/$defs/avatarSplitImage"}
        ]
      }
    }
  },
  "$defs": {
    "baseProperties": {
      "segment_id": {"type": "string", "minLength": 1, "maxLength": 160},
      "start_frame": {"type": "integer", "minimum": 0},
      "end_frame_exclusive": {"type": "integer", "minimum": 1},
      "source_audio_start_ms": {"type": "integer", "minimum": 0},
      "source_audio_end_ms": {"type": "integer", "minimum": 1},
      "phrase": {"type": "string", "minLength": 1, "maxLength": 4000},
      "word_start": {"type": "integer", "minimum": 0},
      "word_end_exclusive": {"type": "integer", "minimum": 1}
    },
    "avatarSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_key", "span_audio_task_key"],
      "properties": {
        "task_key": {"type": "string", "minLength": 1, "maxLength": 240},
        "span_audio_task_key": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "imageSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_key"],
      "properties": {
        "task_key": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "avatarFull": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id", "start_frame", "end_frame_exclusive",
        "source_audio_start_ms", "source_audio_end_ms", "timeline_composition",
        "phrase", "word_start", "word_end_exclusive", "required_slots"
      ],
      "properties": {
        "segment_id": {"$ref": "#/$defs/baseProperties/segment_id"},
        "start_frame": {"$ref": "#/$defs/baseProperties/start_frame"},
        "end_frame_exclusive": {"$ref": "#/$defs/baseProperties/end_frame_exclusive"},
        "source_audio_start_ms": {"$ref": "#/$defs/baseProperties/source_audio_start_ms"},
        "source_audio_end_ms": {"$ref": "#/$defs/baseProperties/source_audio_end_ms"},
        "timeline_composition": {"const": "AVATAR_FULL"},
        "phrase": {"$ref": "#/$defs/baseProperties/phrase"},
        "word_start": {"$ref": "#/$defs/baseProperties/word_start"},
        "word_end_exclusive": {"$ref": "#/$defs/baseProperties/word_end_exclusive"},
        "required_slots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["avatar"],
          "properties": {"avatar": {"$ref": "#/$defs/avatarSlot"}}
        }
      }
    },
    "imageFull": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id", "start_frame", "end_frame_exclusive",
        "source_audio_start_ms", "source_audio_end_ms", "timeline_composition",
        "phrase", "word_start", "word_end_exclusive", "in_image_shot_role",
        "required_slots"
      ],
      "properties": {
        "segment_id": {"$ref": "#/$defs/baseProperties/segment_id"},
        "start_frame": {"$ref": "#/$defs/baseProperties/start_frame"},
        "end_frame_exclusive": {"$ref": "#/$defs/baseProperties/end_frame_exclusive"},
        "source_audio_start_ms": {"$ref": "#/$defs/baseProperties/source_audio_start_ms"},
        "source_audio_end_ms": {"$ref": "#/$defs/baseProperties/source_audio_end_ms"},
        "timeline_composition": {"const": "IMAGE_FULL"},
        "phrase": {"$ref": "#/$defs/baseProperties/phrase"},
        "word_start": {"$ref": "#/$defs/baseProperties/word_start"},
        "word_end_exclusive": {"$ref": "#/$defs/baseProperties/word_end_exclusive"},
        "in_image_shot_role": {"$ref": "#/$defs/shotRole"},
        "required_slots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": {"image": {"$ref": "#/$defs/imageSlot"}}
        }
      }
    },
    "avatarSplitImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id", "start_frame", "end_frame_exclusive",
        "source_audio_start_ms", "source_audio_end_ms", "timeline_composition",
        "phrase", "word_start", "word_end_exclusive", "in_image_shot_role",
        "required_slots"
      ],
      "properties": {
        "segment_id": {"$ref": "#/$defs/baseProperties/segment_id"},
        "start_frame": {"$ref": "#/$defs/baseProperties/start_frame"},
        "end_frame_exclusive": {"$ref": "#/$defs/baseProperties/end_frame_exclusive"},
        "source_audio_start_ms": {"$ref": "#/$defs/baseProperties/source_audio_start_ms"},
        "source_audio_end_ms": {"$ref": "#/$defs/baseProperties/source_audio_end_ms"},
        "timeline_composition": {"const": "AVATAR_SPLIT_IMAGE"},
        "phrase": {"$ref": "#/$defs/baseProperties/phrase"},
        "word_start": {"$ref": "#/$defs/baseProperties/word_start"},
        "word_end_exclusive": {"$ref": "#/$defs/baseProperties/word_end_exclusive"},
        "in_image_shot_role": {"$ref": "#/$defs/shotRole"},
        "required_slots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["avatar", "right_image"],
          "properties": {
            "avatar": {"$ref": "#/$defs/avatarSlot"},
            "right_image": {"$ref": "#/$defs/imageSlot"}
          }
        }
      }
    },
    "shotRole": {
      "type": "string",
      "enum": [
        "ENVIRONMENTAL_WIDE",
        "HUMAN_MEDIUM",
        "HANDS_ACTION",
        "OBJECT_EVIDENCE",
        "MACRO_DETAIL",
        "REACTION_RESULT"
      ]
    }
  }
}
