{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoforge.local/schemas/artifact-transfer-port-v3.json",
  "title": "VideoForge exact short-lived artifact transfer port v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reservation_id", "account_id", "workspace_id", "method", "path", "content_type", "content_length", "checksum_sha256", "expires_at", "max_uses", "capability_handle"],
  "properties": {
    "schema_version": {"const": "artifact-transfer-port/v3"},
    "reservation_id": {"$ref": "#/$defs/id"},
    "account_id": {"$ref": "#/$defs/id"},
    "workspace_id": {"$ref": "#/$defs/id"},
    "method": {"enum": ["PUT", "GET", "DELETE"]},
    "path": {"type": "string", "minLength": 2, "maxLength": 1401, "pattern": "^/tenant/[A-Za-z0-9._:/-]+$"},
    "content_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$"},
    "content_length": {"type": "integer", "minimum": 0, "maximum": 10737418240},
    "checksum_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "max_uses": {"type": "integer", "minimum": 1, "maximum": 3},
    "capability_handle": {"type": "string", "minLength": 32, "maxLength": 512, "pattern": "^[A-Za-z0-9._:-]+$"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}
  }
}
