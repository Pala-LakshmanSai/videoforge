{
  "name": "@videoforge/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./canonical-json": {
      "types": "./dist/src/canonical-json.d.ts",
      "import": "./dist/src/canonical-json.js"
    },
    "./create-project": {
      "types": "./dist/src/create-project.d.ts",
      "import": "./dist/src/create-project.js"
    },
    "./image-style-edit": {
      "types": "./dist/src/image-style-edit.d.ts",
      "import": "./dist/src/image-style-edit.js"
    },
    "./output-rules": {
      "types": "./dist/src/output-rules.d.ts",
      "import": "./dist/src/output-rules.js"
    },
    "./generated/*": "./generated/*"
  },
  "scripts": {
    "build": "pnpm sync:check && tsc -p tsconfig.build.json",
    "lint": "eslint src scripts tests --max-warnings 0",
    "python:install": "node scripts/bootstrap-python.mjs",
    "sync": "node scripts/sync-contracts.mjs",
    "sync:check": "node scripts/sync-contracts.mjs --check",
    "test": "pnpm test:ts && pnpm test:python",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:ts": "node --test tests/*.test.mjs",
    "test:typescript": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "eslint": "9.35.0",
    "typescript": "5.9.2"
  }
}
