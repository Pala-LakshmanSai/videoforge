{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoforge.local/schemas/worker-health-v1.json",
  "title": "VideoForge Worker Health v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "worker_id",
    "process_state",
    "model_state",
    "provider_mode",
    "synthetic",
    "provider_calls_authorized",
    "external_spend_usd",
    "capabilities"
  ],
  "properties": {
    "schema_version": { "const": "worker-health/v1" },
    "worker_id": {
      "type": "string",
      "enum": ["image-media", "avatar-primary", "avatar-repair", "avatar-quality"]
    },
    "process_state": { "type": "string", "enum": ["starting", "ready", "unhealthy"] },
    "model_state": { "type": "string", "enum": ["not_loaded", "loading", "ready", "failed"] },
    "provider_mode": { "type": "string", "enum": ["fixture", "local", "sandbox", "production"] },
    "synthetic": { "type": "boolean" },
    "provider_calls_authorized": { "type": "boolean" },
    "external_spend_usd": { "type": "number", "minimum": 0 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
