{
  "name": "@videoforge/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./prompts": {
      "types": "./dist/src/prompts/runtime.d.ts",
      "import": "./dist/src/prompts/runtime.js"
    },
    "./database": {
      "types": "./dist/src/database/index.d.ts",
      "import": "./dist/src/database/index.js"
    },
    "./auth": {
      "types": "./dist/src/auth/index.d.ts",
      "import": "./dist/src/auth/index.js"
    },
    "./adapters": {
      "types": "./dist/src/adapters/index.d.ts",
      "import": "./dist/src/adapters/index.js"
    },
    "./postgres": {
      "types": "./dist/src/adapters/postgres.d.ts",
      "import": "./dist/src/adapters/postgres.js"
    },
    "./vocabulary": {
      "types": "./dist/src/database/vocabulary.d.ts",
      "import": "./dist/src/database/vocabulary.js"
    },
    "./admission": {
      "types": "./dist/src/admission/index.d.ts",
      "import": "./dist/src/admission/index.js"
    },
    "./repositories": {
      "types": "./dist/src/repositories/index.d.ts",
      "import": "./dist/src/repositories/index.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime/index.d.ts",
      "import": "./dist/src/runtime/index.js"
    },
    "./recovery": {
      "types": "./dist/src/recovery/index.d.ts",
      "import": "./dist/src/recovery/index.js"
    },
    "./global-session": {
      "types": "./dist/src/global-session/index.d.ts",
      "import": "./dist/src/global-session/index.js"
    },
    "./provider-free-orchestration": {
      "types": "./dist/src/global-session/provider-free-orchestration.d.ts",
      "import": "./dist/src/global-session/provider-free-orchestration.js"
    },
    "./migrations/*": "./migrations/*"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests --max-warnings 0",
    "test": "node --test --test-concurrency=4 tests/*.test.mjs",
    "test:typescript": "node --test --test-concurrency=4 tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@videoforge/contracts": "workspace:*",
    "@videoforge/pipeline": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "eslint": "9.35.0",
    "pg": "8.16.3",
    "typescript": "5.9.2"
  }
}
