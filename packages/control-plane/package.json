{
  "name": "@videoforge/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./database": {
      "types": "./dist/src/database/index.d.ts",
      "import": "./dist/src/database/index.js"
    },
    "./repositories": {
      "types": "./dist/src/repositories/index.d.ts",
      "import": "./dist/src/repositories/index.js"
    },
    "./migrations/*": "./migrations/*"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests --max-warnings 0",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/node": "22.18.0",
    "eslint": "9.35.0",
    "typescript": "5.9.2"
  }
}
