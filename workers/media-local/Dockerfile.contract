# Contract-only local smoke image. No whisper model, GPU, credentials, or provider runtime.
FROM postgres:16-alpine@sha256:16bc17c64a573ef34162af9298258d1aec548232985b33ed7b1eac33ba35c229

RUN apk add --no-cache python3=3.12.13-r0 py3-pip=25.1.1-r1 \
    && pip install --break-system-packages --no-cache-dir \
      jsonschema==4.25.1 \
      pydantic==2.11.7

COPY packages/contracts/python /opt/videoforge/packages/contracts/python
COPY workers/image-media/src /opt/videoforge/workers/image-media/src
COPY workers/media-local/src /opt/videoforge/workers/media-local/src

ENV LANG=C \
    LC_ALL=C \
    PYTHONHASHSEED=0 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/videoforge/packages/contracts/python:/opt/videoforge/workers/image-media/src:/opt/videoforge/workers/media-local/src

ENTRYPOINT ["python3", "-m", "videoforge_media_local.contract_probe"]
