FROM pytorch/pytorch@sha256:7b324d212a4450795b49edba9949b7cdc72429148a64e974334bfe5774d51385

ARG MAGE_SOURCE_REVISION=1108f2ac5e412b27accb0e5d51c90ef2ba39784d

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --filter=blob:none https://github.com/Comfy-Org/ComfyUI.git /opt/comfyui \
    && git -C /opt/comfyui checkout --detach "$MAGE_SOURCE_REVISION" \
    && test "$(git -C /opt/comfyui rev-parse HEAD)" = "$MAGE_SOURCE_REVISION" \
    && rm -rf /opt/comfyui/.git

COPY requirements.mage.txt /opt/videoforge/requirements.mage.txt
RUN python -m pip install --no-cache-dir -r /opt/comfyui/requirements.txt \
    && python -m pip install --no-cache-dir -r /opt/videoforge/requirements.mage.txt

COPY src /opt/videoforge/src
COPY mage_bootstrap.py mage_handler.py mage-entrypoint.py /opt/videoforge/

ENV COMFY_ROOT=/opt/comfyui \
    MAGE_MODEL_ROOT=/models/mage-flow-turbo \
    MAGE_SOURCE_REVISION=1108f2ac5e412b27accb0e5d51c90ef2ba39784d \
    HF_HOME=/models/.cache \
    HF_HUB_DISABLE_TELEMETRY=1 \
    PYTHONPATH=/opt/videoforge/src:/opt/videoforge \
    PYTHONUNBUFFERED=1

WORKDIR /opt/videoforge
ENTRYPOINT ["python", "/opt/videoforge/mage-entrypoint.py"]
