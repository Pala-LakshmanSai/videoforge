# syntax=docker/dockerfile:1.7

# Source-only overlay for the already published Mage image.  The digest-pinned
# base owns the runtime, dependencies, model policy, and Serverless entrypoint.
FROM ghcr.io/pala-lakshmansai/videoforge-mage-v2-07@sha256:91ef608fbb15bc69213c73a598a8915fa4dfa938d02c619454e42319a6475f62

ARG VIDEOFORGE_SOURCE_COMMIT

LABEL org.opencontainers.image.title="VideoForge Mage Serverless Worker (repaired)" \
      org.opencontainers.image.version="v2-07-serverless-repair" \
      org.opencontainers.image.revision="${VIDEOFORGE_SOURCE_COMMIT}" \
      org.opencontainers.image.base.name="ghcr.io/pala-lakshmansai/videoforge-mage-v2-07" \
      org.opencontainers.image.base.digest="sha256:91ef608fbb15bc69213c73a598a8915fa4dfa938d02c619454e42319a6475f62" \
      ai.videoforge.source-commit="${VIDEOFORGE_SOURCE_COMMIT}" \
      ai.videoforge.repair.kind="source-only-overlay" \
      ai.videoforge.base-image="ghcr.io/pala-lakshmansai/videoforge-mage-v2-07@sha256:91ef608fbb15bc69213c73a598a8915fa4dfa938d02c619454e42319a6475f62"

# Keep the current immutable base image's ENV, ENTRYPOINT, runtime-hygiene
# modules, and sealed-volume safeguards. The source-only repair changes only
# these exact runtime files; model preparation remains outside the image definition.
COPY workers/common/serverless_envelope.py /opt/videoforge/common/serverless_envelope.py
COPY workers/image-media/mage_serverless.py /opt/videoforge/mage_serverless.py
COPY packages/contracts/python/videoforge_contracts/_schema_documents.py /opt/videoforge/src/videoforge_contracts/_schema_documents.py
