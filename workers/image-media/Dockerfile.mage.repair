# syntax=docker/dockerfile:1.7

# Source-only overlay for the already published Mage image.  The digest-pinned
# base owns the runtime, dependencies, model policy, and Serverless entrypoint.
FROM ghcr.io/pala-lakshmansai/videoforge-mage-v2-07@sha256:ab5043715f422c20ad1190f063c4f9e66f0d73907738c1ff185ab4d37a57af4e

LABEL org.opencontainers.image.title="VideoForge Mage Serverless Worker (repaired)" \
      org.opencontainers.image.version="v2-07-serverless-repair" \
      org.opencontainers.image.revision="d1d704c2f39581e745ba90151c7388673107de41" \
      org.opencontainers.image.base.name="ghcr.io/pala-lakshmansai/videoforge-mage-v2-07" \
      org.opencontainers.image.base.digest="sha256:ab5043715f422c20ad1190f063c4f9e66f0d73907738c1ff185ab4d37a57af4e" \
      ai.videoforge.source-commit="d1d704c2f39581e745ba90151c7388673107de41" \
      ai.videoforge.repair.kind="source-only-overlay" \
      ai.videoforge.base-image="ghcr.io/pala-lakshmansai/videoforge-mage-v2-07@sha256:ab5043715f422c20ad1190f063c4f9e66f0d73907738c1ff185ab4d37a57af4e"

# Keep the base image's ENV, ENTRYPOINT, and all sealed-volume safeguards.  These
# are the only changed payload files in the repaired image.  The runtime
# hygiene overlay is intentionally kept separate from model preparation.
COPY workers/image-media/mage_serverless.py /opt/videoforge/mage_serverless.py
COPY workers/image-media/mage_runtime.py /opt/videoforge/mage_runtime.py
COPY workers/image-media/mage_bootstrap.py /opt/videoforge/mage_bootstrap.py
COPY workers/image-media/src/videoforge_image_media/mage_production.py \
     /opt/videoforge/src/videoforge_image_media/mage_production.py
