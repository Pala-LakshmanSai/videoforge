# syntax=docker/dockerfile:1.7

# Source-only overlay for the already published Mage image.  The digest-pinned
# base owns the runtime, dependencies, model policy, and Serverless entrypoint.
FROM ghcr.io/pala-lakshmansai/videoforge-mage-v2-07@sha256:8a5b8f453c694b2eeee097e3d958b08c5e47c15290b5cdc17a4fb7e5e3e4f497

LABEL org.opencontainers.image.title="VideoForge Mage Serverless Worker (repaired)" \
      org.opencontainers.image.version="v2-07-serverless-repair" \
      org.opencontainers.image.revision="a52e7e49b8e9cb945e6c5df5412b3f08fa5fff1c" \
      org.opencontainers.image.base.name="ghcr.io/pala-lakshmansai/videoforge-mage-v2-07" \
      org.opencontainers.image.base.digest="sha256:8a5b8f453c694b2eeee097e3d958b08c5e47c15290b5cdc17a4fb7e5e3e4f497" \
      ai.videoforge.source-commit="a52e7e49b8e9cb945e6c5df5412b3f08fa5fff1c" \
      ai.videoforge.repair.kind="source-only-overlay" \
      ai.videoforge.base-image="ghcr.io/pala-lakshmansai/videoforge-mage-v2-07@sha256:8a5b8f453c694b2eeee097e3d958b08c5e47c15290b5cdc17a4fb7e5e3e4f497"

# Keep the current immutable base image's ENV, ENTRYPOINT, runtime-hygiene
# modules, and sealed-volume safeguards. The inline-wire repair changes only
# this handler file; model preparation remains outside the image definition.
COPY workers/image-media/mage_serverless.py /opt/videoforge/mage_serverless.py
