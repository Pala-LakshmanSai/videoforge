{
  "rules": [
    {
      "allowed": {
        "origins": ["__V2_06_EXACT_PUBLIC_ORIGIN__"],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["Content-Type", "x-amz-checksum-sha256"]
      },
      "exposeHeaders": ["Content-Length", "Content-Type", "ETag", "x-amz-checksum-sha256"],
      "maxAgeSeconds": 3600
    }
  ]
}
