{
  "$schema": "../../apps/web/node_modules/wrangler/config-schema.json",
  "name": "videoforge-v207-output",
  "main": "../../apps/web/worker/v207-qualification-output.ts",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
    },
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "r2_buckets": [
    {
      "binding": "PRIVATE_ARTIFACTS",
      "bucket_name": "videoforge-v2-06-staging-private",
    },
  ],
}
